---
import { marquee } from '../data/site';
---

<section aria-label="Disciplinas" class="relative z-10 overflow-hidden border-y border-ink bg-accent py-4">
	<div data-marquee class="flex w-max">
		{
			[0, 1].map((copy) => (
				<ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
					{marquee.map((item) => (
						<li class="flex items-center text-2xl font-medium tracking-tighter whitespace-nowrap uppercase md:text-4xl">
							<span class="px-6 md:px-10">{item}</span>
							<svg viewBox="0 0 20 20" class="size-4 md:size-5" aria-hidden="true">
								<path d="M10 0v20M0 10h20M2.9 2.9l14.2 14.2M17.1 2.9 2.9 17.1" stroke="currentColor" stroke-width="2" />
							</svg>
						</li>
					))}
				</ul>
			))
		}
	</div>
</section>

<script>
	import { gsap, ScrollTrigger, reducedMotion } from '../scripts/motion';

	const track = document.querySelector<HTMLElement>('[data-marquee]');

	if (track && !reducedMotion) {
		const loop = gsap.to(track, { xPercent: -50, duration: 40, ease: 'none', repeat: -1 });

		// Acelera con la velocidad del scroll y vuelve suavemente a su ritmo
		let boost = 1;
		ScrollTrigger.create({
			onUpdate: (self) => (boost = 1 + Math.min(Math.abs(self.getVelocity()) / 300, 5))
		});
		gsap.ticker.add(() => {
			boost += (1 - boost) * 0.05;
			loop.timeScale(loop.timeScale() + (boost - loop.timeScale()) * 0.1);
		});
	}
</script>
