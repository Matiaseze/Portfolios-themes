---
import SectionHeader from './ui/SectionHeader.astro';
import { experience } from '../data/site';
---

<section id="experiencia" class="relative z-10 py-24 md:py-40">
	<div class="container-page">
		<SectionHeader index="05" label="Trayectoria" aside="Formación y experiencia" />

		<h2 data-split class="heading-xl mt-12 md:mt-20">Trayectoria</h2>

		<ul data-reveal-stagger class="mt-16 border-b border-ink/20 md:mt-24">
			{
				experience.map((item) => (
					<li class="group relative isolate grid grid-cols-12 items-baseline gap-4 overflow-hidden border-t border-ink/20 py-6 md:py-8">
						<span
							aria-hidden="true"
							class="absolute inset-0 -z-10 origin-bottom scale-y-0 bg-accent transition-transform duration-500 ease-out-expo group-hover:scale-y-100"
						/>
						<span class="label col-span-3 text-muted md:col-span-2">{item.year}</span>
						<span class="col-span-9 text-xl font-medium tracking-tight uppercase transition-transform duration-500 ease-out-expo group-hover:translate-x-2 md:col-span-5 md:text-2xl">
							{item.role}
						</span>
						<span class="col-span-9 col-start-4 text-ink/70 md:col-span-3 md:col-start-auto">{item.place}</span>
						<span class="label hidden justify-self-end md:col-span-2 md:block">{item.type}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
