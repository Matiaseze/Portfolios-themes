---
import SectionHeader from './ui/SectionHeader.astro';
import { about } from '../data/site';
---

<section id="sobre-mi" class="relative z-10 py-24 md:py-40">
	<div class="container-page">
		<SectionHeader index="01" label="Sobre mí" aside="Perfil" />

		<div class="mt-12 grid gap-10 md:mt-20 lg:grid-cols-12">
			<p data-reveal class="label text-muted lg:col-span-3">(Quién soy)</p>
			<p data-scrub class="text-3xl leading-[1.1] font-medium tracking-tight text-balance md:text-5xl lg:col-span-9">
				{about.text}
			</p>
		</div>

		<dl data-reveal-stagger class="mt-20 grid grid-cols-2 gap-x-4 gap-y-12 md:mt-32 md:grid-cols-4 md:gap-x-8">
			{
				about.stats.map((stat) => (
					<div class="flex flex-col-reverse gap-6 border-t border-ink pt-4">
						<dt class="label text-muted">{stat.label}</dt>
						<dd data-counter={stat.value} data-suffix={stat.suffix} class="text-6xl font-medium tracking-tighter md:text-8xl">
							{stat.value}
							{stat.suffix}
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
