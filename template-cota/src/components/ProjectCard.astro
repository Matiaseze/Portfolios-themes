---
interface Props {
	index: number;
	title: string;
	category: string;
	year: number;
	summary: string;
	tags: string[];
	class?: string;
}

const { index, title, category, year, summary, tags, class: className } = Astro.props;
const fig = String(index + 1).padStart(2, '0');
---

<article class:list={['group', className]}>
	<div class="blueprint relative aspect-[4/3] overflow-hidden">
		<!-- Placeholder de plano técnico en lugar de imagen -->
		<div data-parallax="0.08" class="absolute -inset-y-[10%] inset-x-0 flex items-center justify-center">
			<span
				class="text-[34vw] leading-none font-semibold tracking-tighter text-transparent transition-transform duration-700 ease-out-expo group-hover:scale-110 md:text-[16vw]"
				style="-webkit-text-stroke: 1px rgb(21 21 21 / 0.25)"
			>
				{fig}
			</span>
		</div>

		<div class="label absolute inset-x-0 top-0 flex justify-between p-4 text-ink/60">
			<span>Fig. {fig}</span>
			<span>{category}</span>
		</div>

		<!-- Cota decorativa -->
		<div class="label absolute inset-x-4 bottom-4 flex items-center gap-3 text-ink/50">
			<span class="h-3 w-px bg-current"></span>
			<span class="h-px flex-1 bg-current"></span>
			<span>{year}</span>
			<span class="h-px flex-1 bg-current"></span>
			<span class="h-3 w-px bg-current"></span>
		</div>

		<span class="absolute top-1/2 left-1/2 grid size-20 -translate-1/2 scale-0 place-items-center rounded-full bg-accent transition-transform duration-500 ease-out-expo group-hover:scale-100">
			<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5">
				<path d="M4 12 12 4M5.5 4H12v6.5" />
			</svg>
		</span>
	</div>

	<div class="mt-4 flex items-start justify-between gap-4 border-t border-ink pt-4">
		<h3 class="text-2xl leading-tight font-medium tracking-tighter uppercase md:text-3xl">{title}</h3>
		<span class="label shrink-0 pt-1.5 text-muted">{year}</span>
	</div>
	<p class="mt-3 max-w-md text-ink/70">{summary}</p>
	<ul class="mt-4 flex flex-wrap gap-2">
		{tags.map((tag) => <li class="label rounded-full border border-ink/30 px-3 py-1">{tag}</li>)}
	</ul>
</article>
